{
  "name": "arcade",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "build": "bun run --filter '@arcade/web' build",
    "start": "./scripts/dev.sh",
    "stop": "./scripts/dev-stop.sh",
    "start:docker": "docker compose -f docker/compose.yml --profile docker up -d --build",
    "stop:docker": "docker compose -f docker/compose.yml --profile docker down",
    "start:prod": "./scripts/prod-start.sh",
    "stop:prod": "./scripts/prod-stop.sh"
  }
}
